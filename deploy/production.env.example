# Production .env for docker-compose.yml on one server (docs/19-vps.md). Copy it next to docker-compose.yml:
#   cp deploy/production.env.example .env && chmod 600 .env
# Replace every CHANGE_ME. Never commit the filled-in file.

# ── Images (docs/18-updates.md): pin a release; change these two lines to update ─────────────────────
MGPL_API_VERSION=latest
MGPL_DASHBOARD_VERSION=latest

# ── Ports and proxies ──────────────────────────────────────────────────────────────────────────────────
# nginx only on localhost: Caddy on the host terminates HTTPS and forwards here. (Docker's own port rules
# bypass ufw, so never publish 8080 on all interfaces.)
HTTP_PORT=127.0.0.1:8080
# proxies in front of the api: Caddy + nginx. The login rate limits use the client IP this gives.
TRUST_PROXY=2
API_REPLICAS=2

# ── App ───────────────────────────────────────────────────────────────────────────────────────────────
NODE_ENV=production
# the address people open (no trailing slash). The dashboard signs in with httpOnly cookies
# (Secure, SameSite=Strict) that the api accepts only from this origin or its own host.
CORS_ORIGINS=https://CHANGE_ME.example.in
PASSWORD_RESET_URL=https://CHANGE_ME.example.in/reset-password
# openssl rand -base64 48   (the same value on every api and the worker; this file gives it to all)
JWT_SECRET=CHANGE_ME
GRAPHIQL=false
INTROSPECTION=false
MGPL_SAMPLES=false
DEVICE_BINDING=enforce

# ── Database (the compose file builds DATABASE_URL from this) ──────────────────────────────────────
# openssl rand -hex 24   (URL-safe characters only)
POSTGRES_PASSWORD=CHANGE_ME

# ── Mail: password-reset links (any SMTP provider with TLS) ─────────────────────────────────────────
# URL-encode the user and password (@ → %40). Examples in .env.example.
SMTP_URL=smtps://CHANGE_ME%40example.in:APP_PASSWORD@smtp.example.in:465
MAIL_FROM="Maa Gayatri Path Lab <no-reply@CHANGE_ME.example.in>"

# ── Signatures on reports and invoices (optional) ────────────────────────────────────────────────────
# Mount the folder in docker-compose.yml (x-api volumes) and point these at the files inside it.
# MGPL_SIGNATURE_HEADER_FILE=/secure/signature-header.png
# MGPL_SIGNATURE_NONHEADER_FILE=/secure/signature-nonheader.png

# ── Update notices (on by default; one GET to GitHub per 6 h) ───────────────────────────────────────
# UPDATE_CHECK=true
