{
  "name": "@mgpl-diagnostics/api",
  "version": "0.1.0",
  "private": true,
  "description": "MGPL Diagnostics backend: one GraphQL endpoint (GraphQL Yoga on Fastify) over the kits (auth, db, catalog, report, invoice, finance, tally) used as internal libraries, plus a BullMQ worker on Redis.",
  "type": "module",
  "license": "SEE LICENSE IN LICENSE",
  "repository": "github:mgpl-diagnostics/api",
  "main": "./dist/main.js",
  "scripts": {
    "kits": "node scripts/kits.mjs",
    "dev": "tsx watch src/main.ts",
    "worker:dev": "tsx watch src/worker.ts",
    "start": "node dist/main.js",
    "worker": "node dist/worker.js",
    "db:sync": "node dist/sync.js",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "tsx test/run.ts",
    "schema": "tsx scripts/print-schema.ts",
    "seed": "tsx scripts/seed.ts",
    "llms": "node scripts/llms-full.mjs @mgpl-diagnostics/api README.md AGENTS.md llms.txt docs package.json kits.json schema.graphql src scripts test",
    "docs:reference": "tsx scripts/api-reference.ts"
  },
  "dependencies": {
    "@graphql-tools/schema": "^10.1.5",
    "@mgpl-diagnostics/auth-kit": "^1.2.0",
    "@mgpl-diagnostics/catalog-kit": "^1.0.0",
    "@mgpl-diagnostics/db-kit": "^2.0.0",
    "@mgpl-diagnostics/finance-kit": "^1.0.0",
    "@mgpl-diagnostics/invoice-kit": "^2.0.0",
    "@mgpl-diagnostics/ledger-kit": "^0.1.0",
    "@mgpl-diagnostics/mail-kit": "^0.1.0",
    "@mgpl-diagnostics/report-kit": "^2.0.0",
    "@mgpl-diagnostics/security-kit": "^0.2.0",
    "bullmq": "^5.81.5",
    "fastify": "^5.12.7",
    "graphql": "^17.0.2",
    "graphql-yoga": "^5.24.6",
    "ioredis": "^5.11.1",
    "mongoose": "^9.11.2",
    "pg": "^8.23.1",
    "pg-hstore": "^2.3.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sequelize": "^6.37.8"
  },
  "devDependencies": {
    "@mgpl-diagnostics/client": "^1.2.0",
    "@types/node": "^22.20.5",
    "embedded-postgres": "^18.4.0-beta.17",
    "ioredis-mock": "^8.13.1",
    "mongodb-memory-server": "^11.3.0",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20"
  }
}
