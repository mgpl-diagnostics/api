# MGPL Diagnostics API: every environment variable the API, the worker and `npm run seed` read.
#
#   cp .env.example .env      (.env is git-ignored; never commit it)
#
# `npm run dev`, `npm start`, `npm run worker` and `npm run seed` load `.env` from the working directory.
# Variables already set in the real environment (Docker, systemd, your host's dashboard) win over the file.
# The full table with defaults is docs/09-configuration.md; production checks are in docs/12-deployment.md.
#
# Legend:  [required in production]  [secret]  [optional]
# Commented-out lines show the default (or an example); uncomment to change them.
# The uncommented values below work for local development as they are.


# ── Runtime ──────────────────────────────────────────────────────────────────────────────────────────
# development | production | test. "production" turns off GraphiQL, introspection and samples by default,
# refuses CORS_ORIGINS="*", and makes DATABASE_URL and JWT_SECRET (and MAIL_FROM with SMTP_URL) required.
NODE_ENV=development


# ── HTTP server ──────────────────────────────────────────────────────────────────────────────────────
# [optional] Interface and port to listen on.
# HOST=0.0.0.0
PORT=4000
# [optional] URL path of the one GraphQL endpoint (GET /health is the only other route).
# GRAPHQL_PATH=/graphql
# [required in production] Comma-separated browser origins allowed to call the API.
# "*" is allowed only in development. Example: https://app.example.in,https://admin.example.in
CORS_ORIGINS=http://localhost:3000
# [optional] How many reverse proxies in front of the API append to X-Forwarded-For, so login limits and
# sessions see the real client IP: false/0 = none (use the socket address), true = 1 (nginx or a load
# balancer), 2 = CDN + load balancer. Entries left of the trusted proxies are ignored (clients can forge them).
# TRUST_PROXY=false
# [optional] Header in which the TLS-terminating proxy sends the client's TLS fingerprint (JA4, or JA3),
# e.g. x-ja4. Needs TRUST_PROXY >= 1 and a proxy that SETS (overwrites) the header on every request
# (docs/06-auth-and-permissions.md#tls-fingerprint). Stored hashed on the session; a change is audited.
# TLS_FINGERPRINT_HEADER=x-ja4
# [optional] Largest request body in bytes (bank-statement CSV imports count against it).
# BODY_LIMIT_BYTES=2000000
# [optional] GraphiQL in the browser and schema introspection. Default: on in development, off in production.
GRAPHIQL=true
INTROSPECTION=true
# [optional] Demo report / invoice samples in `documents`. Default: on in development, off in production.
MGPL_SAMPLES=true


# ── Database (db-kit) ────────────────────────────────────────────────────────────────────────────────
# pg (PostgreSQL) | mongo (MongoDB). Both backends behave identically.
DB_BACKEND=pg
# [required in production] [secret] Connection string for the backend above.
#   PostgreSQL: postgres://USER:PASSWORD@HOST:5432/mgpl
#   MongoDB:    mongodb://USER:PASSWORD@HOST:27017/mgpl?replicaSet=rs0   (a replica set is required: transactions)
#   Through PgBouncer: postgres://USER:PASSWORD@PGBOUNCER_HOST:6432/mgpl   (transaction pooling is supported)
# URL-encode special characters in the password (@ → %40, : → %3A, / → %2F).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/mgpl
# [optional] Connections this process keeps open (the Sequelize pool for pg, the MongoDB driver's pool for mongo),
# per API server and per worker. Behind PgBouncer they are cheap client connections: keep
# (API replicas + workers) × DB_POOL_MAX under PGBOUNCER_MAX_CLIENT_CONN. Without PgBouncer, keep it under
# PostgreSQL's max_connections instead.
# DB_POOL_MAX=10
# DB_POOL_MIN=0
# [optional] Close a pooled connection after this long idle (ms); fail a query that waited this long for one (ms).
# DB_POOL_IDLE_MS=10000
# DB_POOL_ACQUIRE_MS=30000
# [optional] Create missing tables (pg) or indexes (mongo) on start. With several replicas set it to false on
# all of them and run `npm run db:sync` (node dist/sync.js) once per release instead (docs/17-scaling.md).
# DB_SYNC=true


# ── Redis ────────────────────────────────────────────────────────────────────────────────────────────
# [required in production with more than one server, and for the worker] [secret if it holds a password]
# Sessions, refresh tokens, login rate limits, db-kit's read cache and the job queues (BullMQ).
# Empty: all of it lives in this process's memory (one server only, lost on restart; jobs run in the API).
# Example: redis://:PASSWORD@localhost:6379/0   (rediss:// for TLS)
REDIS_URL=


# ── Auth: sessions and tokens (auth-kit) ─────────────────────────────────────────────────────────────
# [required in production] [secret] Signs access tokens (HS256). At least 32 characters each.
# Rotation: put the new secret first and keep the old one after a comma ("NEW,OLD"); the first signs,
# every one verifies. Drop OLD once ACCESS_TOKEN_TTL_MS has passed.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Empty in development: a random secret per process (everyone is signed out on restart).
JWT_SECRET=
# [optional] `iss` claim, checked on every request.
# JWT_ISSUER=mgpl-api
# [optional] Access-token lifetime in ms (15 minutes). Refresh tokens are opaque, single-use, stored hashed.
# ACCESS_TOKEN_TTL_MS=900000
# [optional] A session ends after this long without use (12 hours) ...
# SESSION_IDLE_MS=43200000
# [optional] ... and after this long in any case (30 days).
# SESSION_MAX_AGE_MS=2592000000
# [optional] A refresh from a different device than the one that signed in:
#   enforce = end the session (default)   flag = allow, but audit it   off = ignore
DEVICE_BINDING=enforce


# ── Mail (mail-kit): password-reset emails ───────────────────────────────────────────────────────────
# Who sends: the worker when REDIS_URL is set, otherwise the API process itself.
# Which way, first match wins:
#   1. SMTP_URL set         → mail-kit sends HTML + plain-text mail in the lab's brand over SMTP.
#   2. MAIL_WEBHOOK_URL set → the API/worker POSTs { "to", "subject", "text" } JSON to your relay.
#   3. neither              → reset links are NOT sent (the API still answers true; a warning is logged).
#
# [secret] SMTP server, user and password in one URL:
#   smtps://USER:PASSWORD@HOST:465   implicit TLS (port 465)
#   smtp://USER:PASSWORD@HOST:587    STARTTLS (port 587)
# The port defaults to 465 for smtps:// and 587 for smtp://. URL-encode the user and password
# (an email user "no-reply@example.in" is written no-reply%40example.in). mail-kit refuses to send
# in clear to a remote host; only localhost may skip TLS (e.g. smtp://localhost:1025 for Mailpit).
# Examples (use an app password, never the account password):
#   Gmail / Google Workspace: smtps://no-reply%40example.in:APP_PASSWORD@smtp.gmail.com:465
#   Zoho Mail (India):        smtps://no-reply%40example.in:APP_PASSWORD@smtp.zoho.in:465
#   Amazon SES (Mumbai):      smtp://SMTP_USERNAME:SMTP_PASSWORD@email-smtp.ap-south-1.amazonaws.com:587
#   Brevo:                    smtp://LOGIN:SMTP_KEY@smtp-relay.brevo.com:587
# SMTP_URL=smtps://no-reply%40example.in:APP_PASSWORD@smtp.example.in:465
#
# [required in production with SMTP_URL] Sender shown to patients. The provider's SPF and DKIM records
# must cover this domain, or mail lands in spam. Quote it here because of the spaces and angle brackets.
# Development default: "MGPL Diagnostics <no-reply@localhost.localdomain>".
# MAIL_FROM="Maa Gayatri Path Lab <no-reply@example.in>"
#
# [optional] Used only when SMTP_URL is empty. Your relay receives POST { to, subject, text }.
# MAIL_WEBHOOK_URL=https://mail-relay.internal/send
#
# [required in production for reset mail] The app page that receives the link: <PASSWORD_RESET_URL>?token=…
PASSWORD_RESET_URL=http://localhost:3000/reset-password


# ── Background jobs (worker-kit on BullMQ) ───────────────────────────────────────────────────────────
# Used when REDIS_URL is set: run `npm run worker` (or `node dist/worker.js`) with this same file.
# [optional] Redis key prefix for the queues (change it to share one Redis between environments).
# QUEUE_PREFIX=mgpl
# [optional] Jobs one worker runs at once, per queue.
# WORKER_CONCURRENCY=4
# [optional] How long finished jobs (and their rendered documents) stay readable, in ms (1 hour).
# JOB_RESULT_TTL_MS=3600000


# ── Report and invoice signatures (report-kit) ───────────────────────────────────────────────────────
# [optional] [private files] Real signature images (.png, .jpg or .svg), kept OUTSIDE the repo and mounted
# read-only. Without them, documents use the placeholder signature shipped in report-kit.
# One file for both variants:
# MGPL_SIGNATURE_FILE=/secure/signature.png
# Or one per variant (each overrides MGPL_SIGNATURE_FILE):
# MGPL_SIGNATURE_HEADER_FILE=/secure/signature-header.png
# MGPL_SIGNATURE_NONHEADER_FILE=/secure/signature-nonheader.png


# ── Seed: `npm run seed`, once per new database ──────────────────────────────────────────────────────
# Read only by the seed script. Prefer passing them on the command line (docs/03-getting-started.md);
# if you put them here, remove SEED_OWNER_PASSWORD afterwards and change the password after first sign-in.
# SEED_ORG_NAME="Maa Gayatri Path Lab"
# SEED_ORG_CODE=MGPL
# [optional for billing, required for GSTR-1 / GSTR-3B] Organisation GSTIN.
# SEED_ORG_GSTIN=22AAAAA0000A1Z5
# SEED_BRANCH_CODE=ARG01
# SEED_BRANCH_NAME=Arang
# GST state code of the branch (22 = Chhattisgarh). Billing needs it (CGST+SGST vs IGST).
# SEED_BRANCH_STATE=22
# SEED_OWNER_NAME="Lab Owner"
# SEED_OWNER_EMAIL=owner@example.in
# [secret] Must pass auth-kit's password policy.
# SEED_OWNER_PASSWORD=


# ── Scaling: graceful shutdown, replicas, PgBouncer ──────────────────────────────────────────────────
# Running several API replicas: REDIS_URL and the same JWT_SECRET on every replica (docs/17-scaling.md).
# [optional] On SIGTERM, GET /health answers 503 for this long while requests are still served, so the load
# balancer takes the replica out first (ms). Default 5000 in production, 0 otherwise.
# SHUTDOWN_DRAIN_MS=5000
# [optional] Then the server stops accepting connections and finishes the requests in flight; it exits
# anyway this long after the signal (ms). The worker uses it too, for the jobs in hand.
# SHUTDOWN_TIMEOUT_MS=30000
#
# Read only by docker-compose.yml (Docker Compose reads this file for them), not by the API:
# API_REPLICAS=2                    api containers behind nginx (or `docker compose up -d --scale api=N`)
# HTTP_PORT=8080                    nginx's port on the host
# POSTGRES_PASSWORD=postgres        [secret] URL-safe characters only: it goes into connection URLs
# POSTGRES_MAX_CONNECTIONS=100      PostgreSQL's limit; PgBouncer's server pool must fit under it
# PGBOUNCER_POOL_MODE=transaction   transaction (recommended; `npm test` runs the api under it) | session
# PGBOUNCER_DEFAULT_POOL_SIZE=20    server connections PgBouncer opens to PostgreSQL for the database
# PGBOUNCER_MIN_POOL_SIZE=0
# PGBOUNCER_RESERVE_POOL_SIZE=5     extra server connections when clients have waited 5 s
# PGBOUNCER_MAX_CLIENT_CONN=500     client connections in all: at least (API_REPLICAS + workers) × DB_POOL_MAX
# PGBOUNCER_MAX_DB_CONNECTIONS=50   hard cap on server connections: below POSTGRES_MAX_CONNECTIONS


# ── Development and test tooling (not read by the running API) ──────────────────────────────────────
# NODE_AUTH_TOKEN=          [secret] export it in your shell for `npm ci` (npm does not read .env): GitHub token, read:packages
# KITS_SRC=..               `npm run kits`: build the kits from local checkouts instead of kits.json refs
# TEST_BACKENDS=pg,mongo    `npm test`: which databases to run (pg only when MongoDB binaries can't download)
# MONGOMS_SYSTEM_BINARY=    `npm test`: path to a local mongod
# PGBOUNCER_BIN=pgbouncer   `npm test`: the pgbouncer binary for the [pgbouncer] and [replicas] checks (skipped without it)
# DEBUG=1                   `npm test`: print resolver errors
