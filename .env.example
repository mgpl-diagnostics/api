# Copy to .env (git-ignored) and load it with your process manager, or export the variables.
NODE_ENV=development
PORT=4000
# pg | mongo
DB_BACKEND=pg
DATABASE_URL=postgres://postgres:postgres@localhost:5432/mgpl
# Sessions, refresh tokens, rate limits, the read cache and the job queues (BullMQ, `npm run worker`).
# Leave empty for in-memory (one server only; jobs run in the API process).
REDIS_URL=
# Signs access tokens (>= 32 characters; "new,old" to rotate). Required in production.
JWT_SECRET=
# ACCESS_TOKEN_TTL_MS=900000
# Refresh from another device: enforce | flag | off
DEVICE_BINDING=enforce
# Email relay for reset links (POST { to, subject, text })
# MAIL_WEBHOOK_URL=https://mail-relay.internal/send
# WORKER_CONCURRENCY=4
# Comma-separated browser origins allowed to call the API ("*" only in development)
CORS_ORIGINS=http://localhost:3000
GRAPHIQL=true
INTROSPECTION=true
# Demo report / invoice samples in `documents`
MGPL_SAMPLES=true
# Password-reset links: <PASSWORD_RESET_URL>?token=…
PASSWORD_RESET_URL=http://localhost:3000/reset-password
# Real signatures (never committed): files outside the repo
# MGPL_SIGNATURE_HEADER_FILE=/secure/signature-header.png
# MGPL_SIGNATURE_NONHEADER_FILE=/secure/signature-nonheader.png
